# Serverless Gemini API credentials (NEVER put on client side)
GEMINI_API_KEY=your_gemini_api_key_here

# Model IDs from Google AI Studio (e.g., gemini-2.5-flash or gemini-2.0-flash)
GEMINI_TEXT_MODEL=gemini-2.5-flash
GEMINI_IMAGE_MODEL=imagen-3.0-generate-002

# Feature flags & free-tier guardrails
ENABLE_LIVE_TEXT=true
ENABLE_LIVE_IMAGES=true
LIVE_RUNS_PER_HOUR_PER_IP=3
LIVE_IMAGE_RUNS_PER_DAY_GLOBAL=30

# Site URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000
